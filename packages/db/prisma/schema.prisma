}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @map("user_id")
  marketId  String     @map("market_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market     @relation(fields: [marketId], references: [id], onDelete: Restrict)
  items     CartItem[]

  @@unique([userId, marketId])
  @@index([marketId])
  @@map("carts")
}

model CartItem {
  id         String          @id @default(cuid())
  cartId     String          @map("cart_id")
  productId  String          @map("product_id")
  /// Null when product has no variants. Empty string key used for uniqueness with non-variant lines.
  variantId  String?         @map("variant_id")
  variantKey String          @default("") @map("variant_key") @db.VarChar(64)
  quantity   Int
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model OrderItem {
  id                    String   @id @default(cuid())
  orderId               String   @map("order_id")
  productId             String?  @map("product_id")
  variantId             String?  @map("variant_id")
  vendorId              String   @map("vendor_id")
  fulfillmentType       ProductFulfillmentType @default(DIRECT) @map("fulfillment_type")
  vendorFulfillmentStatus    OrderStatus @default(NEW) @map("vendor_fulfillment_status")
  vendorFulfillmentUpdatedAt DateTime    @default(now()) @map("vendor_fulfillment_updated_at")
  productNameSnapshot   String   @map("product_name_snapshot")
  vendorNameSnapshot    String   @map("vendor_name_snapshot")
  variantTitleSnapshot  String?  @map("variant_title_snapshot") @db.VarChar(200)
  variantSkuSnapshot    String?  @map("variant_sku_snapshot") @db.VarChar(64)
  quantity              Int
  unitIndex             Int?             @map("unit_index")
  unitLabel             String?          @map("unit_label") @db.VarChar(64)
  unitStatus            OrderUnitStatus  @default(ACTIVE) @map("unit_status")
  orderReturnId         String?          @map("order_return_id")
  unitPrice             Decimal  @db.Decimal(18, 2) @map("unit_price")
  lineTotal             Decimal  @db.Decimal(18, 2) @map("line_total")
  createdAt             DateTime @default(now()) @map("created_at")
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant               ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  vendor                Vendor   @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  orderReturn           OrderReturn? @relation("OrderReturnUnits", fields: [orderReturnId], references: [id], onDelete: SetNull)
  rating                OrderItemRating?

  @@index([orderId])
  @@index([vendorId])
  @@index([orderId, vendorId, vendorFulfillmentStatus])
  @@index([orderReturnId])
  @@index([orderId, unitStatus])
  @@map("order_items")
}

model OrderItemRating {
  id            String    @id @default(cuid())
  orderItemId String    @unique @map("order_item_id")
  buyerUserId String    @map("buyer_user_id")
  productStars  Int       @map("product_stars")
  vendorStars   Int       @map("vendor_stars")
  deliveryStars Int       @map("delivery_stars")
  comment       String?   @db.VarChar(2000)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyer         User      @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)

  @@index([buyerUserId, createdAt])
  @@map("order_item_ratings")
}

model CustomerProfile {
  userId                  String   @id @map("user_id")
  phone                   String?
  countryCode             String   @default("SA") @map("country_code")
  city                    String?
  addressLine1            String?  @map("address_line_1")
  addressLine2            String?  @map("address_line_2")
  postalCode              String?  @map("postal_code")
  shipSameAsBilling       Boolean  @default(true) @map("ship_same_as_billing")
  shippingAddressLine1  String?  @map("shipping_address_line_1")
  shippingAddressLine2  String?  @map("shipping_address_line_2")
  shippingCity            String?  @map("shipping_city")
  shippingPostalCode      String?  @map("shipping_postal_code")
  shippingCountryCode     String?  @map("shipping_country_code")
  preferredLanguage       String   @default("en") @map("preferred_language")
  phoneVerifiedAt         DateTime? @map("phone_verified_at")
  internationalShoppingNoticeAcceptedAt DateTime? @map("international_shopping_notice_accepted_at")
  internationalShoppingNoticeVersion String? @map("international_shopping_notice_version") @db.VarChar(32)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([countryCode])
  @@index([preferredLanguage])
  @@map("customer_profiles")
}

model CustomerShippingAddress {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  label           String?  @db.VarChar(80)
  recipientName   String   @map("recipient_name") @db.VarChar(120)
  phone           String   @db.VarChar(32)
  countryCode     String   @map("country_code") @db.Char(2)
  /** Governorate / state (OM, EG). */
  governorate     String?  @db.VarChar(120)
  city            String   @db.VarChar(120)
  neighborhood    String?  @db.VarChar(120)
  building        String?  @db.VarChar(120)
  postalCode      String   @map("postal_code") @db.VarChar(20)
  addressLine1    String   @map("address_line_1") @db.VarChar(200)
  addressLine2    String?  @map("address_line_2") @db.VarChar(200)
  /** Optional free-form full address line. */
  fullAddress     String?  @map("full_address") @db.VarChar(500)
  /** Saudi short national address (e.g. RQCD…. ). */
  shortNationalAddress String? @map("short_national_address") @db.VarChar(64)
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isDefault])
  @@map("customer_shipping_addresses")
}

model Role {
  id        String     @id @default(cuid())
  code      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @map("user_id")
  marketId         String              @map("market_id")
  currency         String              @default("SAR")
  availableBalance Decimal             @default(0) @db.Decimal(18, 2) @map("available_balance")
  pendingBalance   Decimal             @default(0) @db.Decimal(18, 2) @map("pending_balance")
  lockedBalance    Decimal             @default(0) @db.Decimal(18, 2) @map("locked_balance")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  market           Market              @relation(fields: [marketId], references: [id], onDelete: Restrict)
  transactions     WalletTransaction[]

  @@unique([userId, marketId])
  @@index([marketId])
  @@map("wallets")
}

model WalletTransaction {
  id                   String          @id @default(cuid())
  walletId             String          @map("wallet_id")
  userId               String          @map("user_id")
  entryType            WalletEntryType @map("entry_type")
  direction            LedgerDirection
  amount               Decimal         @db.Decimal(18, 2)
  status               LedgerStatus    @default(PENDING)
  referenceType        String          @map("reference_type")
  referenceId          String          @map("reference_id")
  metaJson             Json?           @map("meta_json")
  idempotencyKey       String          @unique @map("idempotency_key")
  /// Future cross-wallet transfer pairing (X5 foresight — no API/UI yet).
  transferGroupId      String?         @map("transfer_group_id") @db.VarChar(64)
  counterpartyWalletId String?         @map("counterparty_wallet_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  wallet               Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  vendorPayoutInvoice  VendorPayoutInvoice?

  @@index([userId, status])
  @@index([userId, entryType, status])
  @@index([status, entryType, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model AffiliateProfile {
  userId       String   @id @map("user_id")
  referralCode String   @unique @map("referral_code")
  rankTitle    String   @default("Member") @map("rank_title") @db.VarChar(32)
  isActive     Boolean  @default(true) @map("is_active")
  internationalMarketingConsentAt      DateTime? @map("international_marketing_consent_at")
  internationalMarketingConsentVersion String?   @map("international_marketing_consent_version") @db.VarChar(32)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       ReferralRelation? @relation("ChildRelation")
  children     ReferralRelation[] @relation("ParentRelation")

  @@map("affiliate_profiles")
}

model ReferralRelation {
  childUserId  String   @unique @map("child_user_id")
  parentUserId String   @map("parent_user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  child        AffiliateProfile @relation("ChildRelation", fields: [childUserId], references: [userId], onDelete: Cascade)
  parent       AffiliateProfile @relation("ParentRelation", fields: [parentUserId], references: [userId], onDelete: Cascade)

  @@id([childUserId, parentUserId])
  @@index([parentUserId])
  @@map("referral_relations")
}

/// Country marketplace (Phase X1). Core tables scoped by market_id (Phase X2).
model Market {
  id              String            @id @default(cuid())
  code            String            @unique @db.VarChar(16)
  subdomain       String            @unique @db.VarChar(32)
  nameEn          String            @map("name_en")
  nameAr          String            @map("name_ar")
  defaultCurrency String            @map("default_currency") @db.Char(3)
  /// Checkout currencies accepted in this market (e.g. OMR, or OMR+USD for International).
  paymentCurrencies String[]        @default([]) @map("payment_currencies")
  geoCountryCodes String[]          @map("geo_country_codes")
  /// Closed/hidden when false — not shown to customers or merchants.
  isActive        Boolean           @default(true) @map("is_active")
  sortOrder       Int               @default(0) @map("sort_order")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  vendors         Vendor[]
  primaryVendors  Vendor[]          @relation("VendorPrimaryMarket")
  products        Product[]
  productOffers   ProductMarketOffer[]
  variantOffers   ProductVariantOffer[]
  orders          Order[]
  categories      ProductCategory[]
  carts           Cart[]
  platformConfigs PlatformConfig[]
  shippingRates   ShippingRate[]
  wallets         Wallet[]
  banners         MarketBanner[]
  contactInquiries ContactInquiry[]
  warehouses      VandsoqWarehouse[]
  invoiceIssuer   MarketInvoiceIssuer?
  platformCoupons PlatformCoupon[]
  wishlistItems   WishlistItem[]
  vendorPayoutInvoices VendorPayoutInvoice[]
  legalPolicyVersions LegalPolicyVersion[]
  refundFeeRules  RefundFeeRule[]
  sellerInvoicingRules MarketInvoicingRule[] @relation("InvoicingSellerMarket")
  buyerInvoicingRules  MarketInvoicingRule[] @relation("InvoicingBuyerMarket")
  consentRecords  ConsentRecord[]
  pendingReacceptUsers User[] @relation("UserPendingMarketReaccept")

  @@map("markets")
}

/// Storefront promo banners per market (Phase X6).
model MarketBanner {
  id         String   @id @default(cuid())
  marketId   String   @map("market_id")
  titleEn    String   @map("title_en") @db.VarChar(200)
  titleAr    String   @map("title_ar") @db.VarChar(200)
  subtitleEn String?  @map("subtitle_en") @db.VarChar(500)
  subtitleAr String?  @map("subtitle_ar") @db.VarChar(500)
  imageUrl   String?  @map("image_url") @db.VarChar(500)
  linkUrl    String?  @map("link_url") @db.VarChar(500)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  market     Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId, isActive, sortOrder])
  @@map("market_banners")
}

enum MissingAncestorPolicy {
  KEEP_BY_PLATFORM
  REDISTRIBUTE_TO_EXISTING_LEVELS
}

/// Per-market platform business rules (Phase X4). One row per market.
model PlatformConfig {
  id                    String                @id @default(cuid())
  marketId              String                @unique @map("market_id")
  cashbackRate          Decimal               @map("cashback_rate") @db.Decimal(8, 6)
  affiliatePoolRate     Decimal               @map("affiliate_pool_rate") @db.Decimal(8, 6)
  affiliateLevel1Rate   Decimal               @map("affiliate_level1_rate") @db.Decimal(8, 6)
  affiliateLevel2Rate   Decimal               @map("affiliate_level2_rate") @db.Decimal(8, 6)
  affiliateLevel3Rate   Decimal               @map("affiliate_level3_rate") @db.Decimal(8, 6)
  affiliateLevel4Rate   Decimal               @map("affiliate_level4_rate") @db.Decimal(8, 6)
  vendorRate            Decimal               @map("vendor_rate") @db.Decimal(8, 6)
  platformRate          Decimal               @map("platform_rate") @db.Decimal(8, 6)
  /// Platform share when sale is outside vendor home market or on International (default 10%).
  platformRateCross     Decimal               @default(0.10) @map("platform_rate_cross") @db.Decimal(8, 6)
  vendorRateCross       Decimal               @default(0.90) @map("vendor_rate_cross") @db.Decimal(8, 6)
  vatRate               Decimal               @map("vat_rate") @db.Decimal(8, 6)
  minWithdrawalAmount   Decimal               @map("min_withdrawal_amount") @db.Decimal(18, 2)
  returnWindowDays      Int                   @map("return_window_days")
  settlementWindowDays  Int                   @default(7) @map("settlement_window_days")
  referralDepthMax      Int                   @default(4) @map("referral_depth_max")
  missingAncestorPolicy MissingAncestorPolicy @default(KEEP_BY_PLATFORM) @map("missing_ancestor_policy")
  /// Access JWT / cookie lifetime in minutes (N-035). Applied from default market config at login.
  sessionAccessMinutes  Int                   @default(15) @map("session_access_minutes")
  termsUrl              String?               @map("terms_url") @db.VarChar(500)
  termsText             String?               @map("terms_text") @db.Text
  privacyUrl            String?               @map("privacy_url") @db.VarChar(500)
  privacyText           String?               @map("privacy_text") @db.Text
  returnPolicyUrl       String?               @map("return_policy_url") @db.VarChar(500)
  returnPolicyText      String?               @map("return_policy_text") @db.Text
  footerTaglineEn       String?               @map("footer_tagline_en") @db.Text
  footerTaglineAr       String?               @map("footer_tagline_ar") @db.Text
  contactLocationEn     String?               @map("contact_location_en") @db.Text
  contactLocationAr     String?               @map("contact_location_ar") @db.Text
  publicContactEmail    String?               @map("public_contact_email") @db.VarChar(254)
  inquiryNotifyEmail    String?               @map("inquiry_notify_email") @db.VarChar(254)
  showTapGateway        Boolean               @default(true) @map("show_tap_gateway")
  showHyperPayGateway   Boolean               @default(true) @map("show_hyperpay_gateway")
  showMyFatoorahGateway Boolean               @default(true) @map("show_myfatoorah_gateway")
  /// COD master switch (latest §8). City-local direct delivery rule enforced in checkout separately.
  codEnabled            Boolean               @default(true) @map("cod_enabled")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  updatedByUserId       String?               @map("updated_by_user_id")
  market                Market                @relation(fields: [marketId], references: [id], onDelete: Cascade)
  changeLogs            PlatformConfigChangeLog[]

  @@map("platform_config")
}

/// Sequential invoice numbers per issuer key (commission / vendor-sale / future MarketInvoiceIssuer).
model InvoiceSerialCounter {
  id        String   @id @default(cuid())
  issuerKey String   @unique @map("issuer_key") @db.VarChar(64)
  prefix    String   @db.VarChar(24)
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoice_serial_counters")
}

/// Market representative company that issues commission / cross-market / shipping invoices.
/// Also holds market-annex contact/legal fields (editable settings; not hard-coded in policy text).
model MarketInvoiceIssuer {
  id              String   @id @default(cuid())
  marketId        String   @unique @map("market_id")
  code            String   @db.VarChar(32)
  legalNameEn     String   @map("legal_name_en") @db.VarChar(200)
  legalNameAr     String   @map("legal_name_ar") @db.VarChar(200)
  commercialRegistration String? @map("commercial_registration") @db.VarChar(64)
  unifiedNumber   String?  @map("unified_number") @db.VarChar(64)
  addressLine1    String   @map("address_line_1") @db.VarChar(200)
  addressLine2    String?  @map("address_line_2") @db.VarChar(200)
  city            String   @db.VarChar(100)
  postalCode      String?  @map("postal_code") @db.VarChar(32)
  countryCode     String   @map("country_code") @db.Char(2)
  phone           String?  @db.VarChar(32)
  email           String?  @db.VarChar(254)
  consumerProtectionAuthorityEn String? @map("consumer_protection_authority_en") @db.VarChar(300)
  consumerProtectionAuthorityAr String? @map("consumer_protection_authority_ar") @db.VarChar(300)
  vatRegistered   Boolean  @default(true) @map("vat_registered")
  vatTrn          String?  @map("vat_trn") @db.VarChar(64)
  vatPercent      Decimal  @default(0) @map("vat_percent") @db.Decimal(5, 2)
  currency        String   @db.Char(3)
  logoUrl         String?  @map("logo_url") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  market          Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@map("market_invoice_issuers")
}

enum LegalDocumentType {
  ABOUT
  TERMS
  PRIVACY
  RETURNS
  SHIPPING
  PRICING_PAYMENT
  CASHBACK_REFERRAL
  MERCHANT_COOPERATION
  MERCHANT_OPERATIONAL
  MERCHANT_COMMISSION
  MERCHANT_DATA_CONFIRMATION
}

/// Versioned legal/policy document per market (public + merchant packs).
model LegalPolicyVersion {
  id          String            @id @default(cuid())
  marketId    String            @map("market_id")
  documentType LegalDocumentType @map("document_type")
  version     String            @db.VarChar(32)
  titleEn     String            @map("title_en") @db.VarChar(200)
  titleAr     String            @map("title_ar") @db.VarChar(200)
  bodyEn      String?           @map("body_en") @db.Text
  bodyAr      String?           @map("body_ar") @db.Text
  /// Null until publish — public pages only show published versions.
  publishedAt DateTime?         @map("published_at")
  isCurrent   Boolean           @default(false) @map("is_current")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  market      Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, documentType, version])
  @@index([marketId, documentType, isCurrent])
  @@index([marketId, documentType, publishedAt])
  @@map("legal_policy_versions")
}

enum InvoicingParty {
  MERCHANT
  PLATFORM
}

/// Who invoices the customer for a seller-market × buyer-market pair (configurable).
model MarketInvoicingRule {
  id              String         @id @default(cuid())
  sellerMarketId  String         @map("seller_market_id")
  buyerMarketId   String         @map("buyer_market_id")
  invoicingParty  InvoicingParty @map("invoicing_party")
  /// Optional override; null → use PlatformConfig home/cross rates.
  commissionRate  Decimal?       @map("commission_rate") @db.Decimal(8, 6)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  sellerMarket    Market         @relation("InvoicingSellerMarket", fields: [sellerMarketId], references: [id], onDelete: Cascade)
  buyerMarket     Market         @relation("InvoicingBuyerMarket", fields: [buyerMarketId], references: [id], onDelete: Cascade)

  @@unique([sellerMarketId, buyerMarketId])
  @@index([buyerMarketId])
  @@map("market_invoicing_rules")
}

/// Phase 5 — per-vendor invoicing party + commission rate locked at order create.
model OrderVendorInvoicing {
  id              String         @id @default(cuid())
  orderId         String         @map("order_id")
  vendorId        String         @map("vendor_id")
  sellerMarketId  String         @map("seller_market_id")
  buyerMarketId   String         @map("buyer_market_id")
  invoicingParty  InvoicingParty @map("invoicing_party")
  commissionRate  Decimal        @map("commission_rate") @db.Decimal(8, 6)
  createdAt       DateTime       @default(now()) @map("created_at")
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor         @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([orderId, vendorId])
  @@index([vendorId])
  @@index([orderId, invoicingParty])
  @@map("order_vendor_invoicing")
}

enum RefundFeeCause {
  PRODUCT_DEFECT
  MERCHANT_MISTAKE
  PLATFORM_MISTAKE
  CUSTOMER_CHANGE_OF_MIND
  CUSTOMER_REFUSED_DELIVERY
}

enum RefundFeePayer {
  MERCHANT
  PLATFORM
  CUSTOMER
}

/// Who bears payment-gateway fees on refund, by cause (configurable per market).
model RefundFeeRule {
  id        String          @id @default(cuid())
  marketId  String          @map("market_id")
  cause     RefundFeeCause
  payer     RefundFeePayer
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  market    Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, cause])
  @@map("refund_fee_rules")
}

model PlatformConfigChangeLog {
  id          String   @id @default(cuid())
  marketId    String   @map("market_id")
  actorUserId String   @map("actor_user_id")
  summary     String   @db.VarChar(500)
  changesJson Json     @map("changes_json")
  createdAt   DateTime @default(now()) @map("created_at")
  config      PlatformConfig @relation(fields: [marketId], references: [marketId], onDelete: Cascade)

  @@index([marketId, createdAt])
  @@map("platform_config_change_logs")
}

enum ConsentContext {
  CUSTOMER_SIGNUP
  CUSTOMER_CHECKOUT
  VENDOR_ONBOARDING
  MARKET_REACCEPT
}

/// Immutable audit row for each policy acceptance (Phase 3 consent ledger).
model ConsentRecord {
  id             String            @id @default(cuid())
  userId         String            @map("user_id")
  marketId       String            @map("market_id")
  documentType   LegalDocumentType @map("document_type")
  policyVersion  String            @map("policy_version") @db.VarChar(32)
  context        ConsentContext
  vendorId       String?           @map("vendor_id")
  orderId        String?           @map("order_id")
  ipAddress      String?           @map("ip_address") @db.VarChar(64)
  userAgent      String?           @map("user_agent") @db.VarChar(512)
  acceptedAt     DateTime          @default(now()) @map("accepted_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  market         Market            @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([userId, context, acceptedAt])
  @@index([marketId, documentType, acceptedAt])
  @@index([vendorId, acceptedAt])
  @@index([orderId])
  @@map("consent_records")
}

/// Manual FX rates for cross-currency vendor settlement (Phase 4).
model FxRate {
  id              String   @id @default(cuid())
  fromCurrency    String   @map("from_currency") @db.Char(3)
  toCurrency      String   @map("to_currency") @db.Char(3)
  rate            Decimal  @db.Decimal(18, 8)
  source          String   @default("MANUAL") @db.VarChar(64)
  effectiveAt     DateTime @default(now()) @map("effective_at")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([fromCurrency, toCurrency, effectiveAt])
  @@index([fromCurrency, toCurrency, effectiveAt(sort: Desc)])
  @@map("fx_rates")
}

model StripeWebhookEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("stripe_webhook_events")
}

model TapWebhookEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(128)
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("tap_webhook_events")
}

model ContactInquiry {
  id        String               @id @default(cuid())
  marketId  String               @map("market_id")
  firstName String               @map("first_name") @db.VarChar(80)
  lastName  String               @map("last_name") @db.VarChar(80)
  email     String               @db.VarChar(254)
  message   String               @db.Text
  status    ContactInquiryStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  market    Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([marketId, createdAt])
  @@index([email])
  @@map("contact_inquiries")
}

/// Admin-managed dropdown options for vendor forms (license types, etc.).
model VendorFormListOption {
  id        String   @id @default(cuid())
  listKey   String   @map("list_key") @db.VarChar(64)
  code      String   @db.VarChar(64)
  labelEn   String   @map("label_en") @db.VarChar(200)
  labelAr   String   @map("label_ar") @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([listKey, code])
  @@index([listKey, isActive, sortOrder])
  @@map("vendor_form_list_options")
}
