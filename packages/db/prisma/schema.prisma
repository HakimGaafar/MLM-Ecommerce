  @@index([vendorId, createdAt])
  @@map("vendor_shipping_audit_logs")
}

model OrderCouponApplication {
  id                 String             @id @default(cuid())
  orderId            String             @map("order_id")
  couponId           String             @map("coupon_id")
  vendorId           String             @map("vendor_id")
  couponCode         String             @map("coupon_code") @db.VarChar(32)
  vendorNameSnapshot String             @map("vendor_name_snapshot") @db.VarChar(200)
  discountType       CouponDiscountType @map("discount_type")
  discountValue      Decimal            @map("discount_value") @db.Decimal(18, 2)
  discountAmount     Decimal            @map("discount_amount") @db.Decimal(18, 2)
  createdAt          DateTime           @default(now()) @map("created_at")
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon             Coupon             @relation(fields: [couponId], references: [id], onDelete: Restrict)
  vendor             Vendor             @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([orderId, couponId])
  @@index([orderId])
  @@index([couponId])
  @@map("order_coupon_applications")
}

model VendorMember {
  id              String             @id @default(cuid())
  vendorId        String             @map("vendor_id")
  email           String             @db.VarChar(255)
  userId          String?            @map("user_id")
  status          VendorMemberStatus @default(PENDING)
  inviteToken     String             @unique @map("invite_token") @db.VarChar(64)
  invitedByUserId String             @map("invited_by_user_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  vendor          Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user            User?              @relation("VendorMemberUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy       User               @relation("VendorMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  permissions     VendorMemberPermission[]

  @@unique([vendorId, email])
  @@index([userId, status])
  @@index([vendorId, status])
  @@map("vendor_members")
}

model VendorMemberPermission {
  memberId String       @map("member_id")
  code     String       @db.VarChar(64)
  member   VendorMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, code])
  @@map("vendor_member_permissions")
}

model VendorBill {
  id          String           @id @default(cuid())
  vendorId    String           @map("vendor_id")
  type        VendorBillType
  description String           @db.VarChar(500)
  amount      Decimal          @db.Decimal(18, 2)
  currency    String           @default("SAR") @db.Char(3)
  status      VendorBillStatus @default(PENDING)
  periodStart DateTime?        @map("period_start")
  periodEnd   DateTime?        @map("period_end")
  createdAt   DateTime         @default(now()) @map("created_at")
  vendor      Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
  @@map("vendor_bills")
}

model Coupon {
  id            String             @id @default(cuid())
  vendorId      String             @map("vendor_id")
  code          String             @db.VarChar(32)
  description   String?            @db.VarChar(500)
  discountType  CouponDiscountType @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(18, 2)
  currency      String             @default("SAR") @db.Char(3)
  status        CouponStatus       @default(DRAFT)
  startsAt      DateTime?          @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  usageLimit    Int?               @map("usage_limit")
  usedCount     Int                @default(0) @map("used_count")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  vendor        Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders        Order[]
  orderApplications OrderCouponApplication[]

  @@unique([vendorId, code])
  @@index([vendorId, status])
  @@map("coupons")
}

/// Phase 7 — platform-funded promo codes (separate from vendor coupons).
model PlatformCoupon {
  id            String             @id @default(cuid())
  marketId      String             @map("market_id")
  code          String             @db.VarChar(32)
  description   String?            @db.VarChar(500)
  discountType  CouponDiscountType @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(18, 2)
  currency      String             @db.Char(3)
  status        CouponStatus       @default(DRAFT)
  startsAt      DateTime?          @map("starts_at")
  endsAt        DateTime?          @map("ends_at")
  usageLimit    Int?               @map("usage_limit")
  usedCount     Int                @default(0) @map("used_count")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  market        Market             @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, code])
  @@index([marketId, status])
  @@map("platform_coupons")
}

/// Phase 7 — customer wishlist per market.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  marketId  String   @map("market_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, marketId, productId])
  @@index([userId, marketId, createdAt])
  @@index([productId])
  @@map("wishlist_items")
}

model VendorPermission {
  vendorId        String   @map("vendor_id")
  code            String   @db.VarChar(64)
  grantedByUserId String?  @map("granted_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([vendorId, code])
  @@index([vendorId])
  @@map("vendor_permissions")
}

model ProductCategory {
  id        String    @id @default(cuid())
  marketId  String    @map("market_id")
  parentId  String?   @map("parent_id")
  slug      String
  nameEn    String    @map("name_en")
  nameAr    String    @map("name_ar")
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  market    Market    @relation(fields: [marketId], references: [id], onDelete: Restrict)
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]

  @@unique([marketId, slug])
  @@index([marketId])
  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id         String           @id @default(cuid())
  marketId   String           @map("market_id")
  vendorId   String           @map("vendor_id")
  categoryId String           @map("category_id")
  name       String
  /// Public URL slug (unique per market). Prefer over id in storefront links.
  slug       String           @db.VarChar(80)
  price      Decimal          @db.Decimal(18, 2)
  currency   String           @default("SAR")
  status          ProductStatus           @default(DRAFT)
  fulfillmentType ProductFulfillmentType  @default(DIRECT) @map("fulfillment_type")
  serviceAreaMode ProductServiceAreaMode  @default(ALL) @map("service_area_mode")
  isActive        Boolean                 @default(false) @map("is_active")
  descriptionEn   String?          @map("description_en") @db.Text
  descriptionAr   String?          @map("description_ar") @db.Text
  metaTitle       String?          @map("meta_title") @db.VarChar(70)
  metaDescription String?          @map("meta_description") @db.VarChar(160)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  vendor     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  market     Market           @relation(fields: [marketId], references: [id], onDelete: Restrict)
  category   ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  reviews    ProductReview[]
  editRequests ProductEditRequest[]
  questions  ProductQuestion[]
  marketOffers ProductMarketOffer[]
  serviceCities ProductServiceCity[]
  wishlistItems WishlistItem[]
  variants   ProductVariant[]

  @@unique([marketId, slug])
  @@index([marketId])
  @@index([vendorId])
  @@index([vendorId, status])
  @@index([categoryId])
  @@index([status, categoryId])
  @@index([marketId, status, categoryId])
  @@map("products")
}

/// Vendor-defined SKU / option row (Size×Color, etc.). Stock & price live on ProductVariantOffer per market.
model ProductVariant {
  id          String               @id @default(cuid())
  productId   String               @map("product_id")
  sku         String?              @db.VarChar(64)
  title       String               @db.VarChar(200)
  /// e.g. {"Color":"Red","Size":"M"}
  optionsJson Json                 @default("{}") @map("options_json")
  sortOrder   Int                  @default(0) @map("sort_order")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  product     Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  offers      ProductVariantOffer[]
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@index([productId, sortOrder])
  @@unique([productId, sku])
  @@map("product_variants")
}

model ProductVariantOffer {
  id        String         @id @default(cuid())
  variantId String         @map("variant_id")
  marketId  String         @map("market_id")
  price     Decimal        @db.Decimal(18, 2)
  currency  String         @db.Char(3)
  quantity  Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  market    Market         @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([variantId, marketId])
  @@index([marketId])
  @@map("product_variant_offers")
}

/// Phase 0 — per sell-market price, stock location, and quantity for a product.
model ProductMarketOffer {
  id               String                   @id @default(cuid())
  productId        String                   @map("product_id")
  marketId         String                   @map("market_id")
  price            Decimal                  @db.Decimal(18, 2)
  currency         String                   @db.Char(3)
  /// Phase 4 — International dual price: OMR mirror of USD-fixed `price` (synced from admin FX).
  secondaryPrice   Decimal?                 @map("secondary_price") @db.Decimal(18, 2)
  secondaryCurrency String?                 @map("secondary_currency") @db.Char(3)
  stockLocation    ProductStockLocation     @map("stock_location")
  warehouseId      String?                  @map("warehouse_id")
  /// VANDSOQ A (pre-stocked) vs B (on-order). Null when stock is at merchant.
  vandsoqMode      VendorIndirectFulfillment? @map("vandsoq_mode")
  quantity         Int                      @default(0)
  /// Phase 5 — listing live in this market only when APPROVED.
  status           ProductMarketOfferStatus @default(DRAFT)
  submittedAt      DateTime?                @map("submitted_at")
  reviewedAt       DateTime?                @map("reviewed_at")
  reviewedByUserId String?                  @map("reviewed_by_user_id")
  rejectionReason  String?                  @map("rejection_reason") @db.VarChar(1000)
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  market           Market                   @relation(fields: [marketId], references: [id], onDelete: Restrict)
  warehouse        VandsoqWarehouse?        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  reviewedBy       User?                    @relation("ProductMarketOfferReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([productId, marketId])
  @@index([marketId, status])
  @@index([status, submittedAt])
  @@index([warehouseId])
  @@map("product_market_offers")
}

/// Phase 0 — VANDSOQ warehouse per domestic market (SA / OM / EG). No GLOBAL warehouse.
model VandsoqWarehouse {
  id          String               @id
  marketId    String               @unique @map("market_id")
  countryCode String               @map("country_code") @db.Char(2)
  name        String               @db.VarChar(120)
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  market      Market               @relation(fields: [marketId], references: [id], onDelete: Restrict)
  offers      ProductMarketOffer[]

  @@index([countryCode])
  @@map("vandsoq_warehouses")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  isPrimary Boolean @default(false) @map("is_primary")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductReview {
  id               String              @id @default(cuid())
  productId        String              @map("product_id")
  action           ProductReviewAction
  target           ProductReviewTarget @default(NEW_PRODUCT)
  rejectionReason  String?             @map("rejection_reason") @db.Text
