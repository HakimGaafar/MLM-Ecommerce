generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerStatus {
  PENDING
  APPROVED
  DECLINED
  REVERSED
}

enum WalletEntryType {
  VENDOR_EARNING
  AFFILIATE_COMMISSION
  CASHBACK
  WITHDRAWAL
  ORDER_PAYMENT
  ADJUSTMENT
  /// COD: platform commission owed by vendor who collected cash (Phase 4).
  COMMISSION_DEBT
  /// Clearing / repayment of COMMISSION_DEBT (Phase 4).
  COMMISSION_DEBT_CLEAR
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  ON_HOLD
  REJECTED
  CHANGES_REQUESTED
}

enum ProductReviewAction {
  APPROVED
  REJECTED
  REQUESTED_CHANGES
}

enum VendorOnboardingStatus {
  UNDER_REGISTRATION
  UNDER_REVIEW
  ACTIVE
}

enum VendorOnboardingFieldDecision {
  PENDING
  ACCEPTED
  NEEDS_FIX
}

enum VendorEntityType {
  INDIVIDUAL
  COMPANY
  ESTABLISHMENT
  FREELANCE
  OTHER
}

enum ProductReviewTarget {
  NEW_PRODUCT
  EDIT_REQUEST
}

enum ProductEditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Phase 5 — per sell-market listing go-live (independent of Product.status).
enum ProductMarketOfferStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum PasswordResetAuditAction {
  RESET_REQUESTED
  RESET_COMPLETED
  CHANGE_NOTIFICATION_SENT
  CHANGE_NOTIFICATION_FAILED
}

enum VendorMemberStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum VendorBillType {
  PLAN_FEE
  PLATFORM_FEE
}

enum VendorBillStatus {
  PENDING
  PAID
  WAIVED
}

enum CouponStatus {
  DRAFT
  ACTIVE
  EXPIRED
  SUSPENDED
  TERMINATED
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

enum PaymentMethod {
  COD
  ONLINE_CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderUnitStatus {
  ACTIVE
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

enum OrderFulfillmentEscalationLevel {
  REMINDER
  WARNING
  ESCALATION
}

enum KycSubjectType {
  CUSTOMER
  AFFILIATE
  VENDOR
}

enum KycDocumentType {
  NATIONAL_ID
  IBAN
  COMMERCIAL_REGISTRATION
  LICENSE
  TAX_CERTIFICATE
  REPRESENTATIVE_ID
  PROOF_OF_ADDRESS
}

enum AffiliateIdentityDocumentKind {
  NATIONAL_ID
  RESIDENCY
  PASSPORT
  OTHER
}

enum VendorStoreApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum KycDocumentStatus {
  UPLOADED
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OrderCustomerNoticeType {
  DELAY
  GENERAL
}

enum OrderVendorCancellationStatus {
  COMPLETED
  FAILED
}

enum InvoiceDocumentType {
  VENDOR_SALE
  /// Cross / International: Representative Company invoices the customer.
  PLATFORM_SALE
  /// Cross / International: Merchant invoices the platform for supply.
  MERCHANT_SUPPLY
  COMMISSION
  SHIPPING
}

enum VendorShippingMode {
  DIRECT
  INDIRECT
}

enum VendorIndirectFulfillment {
  FORSEIZ_STOCK
  ON_ORDER
}

enum ProductFulfillmentType {
  DIRECT
  FORSEIZ_STOCK
  ON_ORDER
}

/// Phase 0 — shipping package type inferred at checkout from stock location + geography.
enum ShippingPackageType {
  VANDSOQ_DOMESTIC
  VANDSOQ_INTERNATIONAL
  MERCHANT_DOMESTIC
  MERCHANT_INTERNATIONAL
}

/// Phase 0 — where product stock sits for a sell-market offer.
enum ProductStockLocation {
  MERCHANT
  VANDSOQ_WAREHOUSE
}

enum ProductServiceAreaMode {
  ALL
  SPECIFIC
}

/// Stage 4 — platform shipping rate list (merchant cannot set checkout fees).
model ShippingRate {
  id          String                        @id @default(cuid())
  marketId    String                        @map("market_id")
  code        String                        @db.VarChar(64)
  packageType ShippingPackageType           @map("package_type")
  vandsoqMode VendorIndirectFulfillment?    @map("vandsoq_mode")
  amount      Decimal                       @db.Decimal(18, 2)
  currency    String                        @default("SAR") @db.Char(3)
  perUnit     Boolean                       @default(true) @map("per_unit")
  isActive    Boolean                       @default(true) @map("is_active")
  createdAt   DateTime                      @default(now()) @map("created_at")
  updatedAt   DateTime                      @updatedAt @map("updated_at")
  market      Market                        @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, code])
  @@index([marketId, packageType, vandsoqMode, isActive])
  @@map("shipping_rates")
}

/// Stage 4 — cities a merchant covers for direct (from-my-stock) delivery.
model VendorDeliveryCity {
  id          String   @id @default(cuid())
  vendorId    String   @map("vendor_id")
  countryCode String   @map("country_code") @db.Char(2)
  city        String   @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, countryCode, city])
  @@index([vendorId, countryCode])
  @@map("vendor_delivery_cities")
}

/// Per-product service / delivery city scope (vendor sets when adding a product).
model ProductServiceCity {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  countryCode String   @map("country_code") @db.Char(2)
  city        String   @db.VarChar(120)
  createdAt   DateTime @default(now()) @map("created_at")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, countryCode, city])
  @@index([productId, countryCode])
  @@map("product_service_cities")
}

enum VendorShippingProfileStatus {
  PENDING_APPROVAL
  APPROVED
}

enum VendorShippingChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactInquiryStatus {
  NEW
  READ
  RESOLVED
}

enum VendorShippingAuditActor {
  ADMIN
  VENDOR_REQUEST_APPROVED
  SYSTEM
}

enum OrderReturnReason {
  DONT_WANT
  INCOMPLETE
  WRONG_ITEM
  COUNTERFEIT
  DEFECTIVE
  USED
  DAMAGED_IN_TRANSIT
}

enum ReturnGoodsDisposition {
  HOLD_AT_HUB
  RETURN_TO_VENDOR
  DISPOSE
}

enum VendorPayoutInvoiceStatus {
  PENDING_REVIEW
  ACCEPTED
  NEEDS_FIX
}

enum OrderReturnStatus {
  REQUESTED
  RECEIPT_IN_PROGRESS
  RECEIPT_COMPLETED
  PROCESSING_IN_PROGRESS
  PROCESSING_COMPLETED
  PROCESSING_REJECTED
  REFUND_IN_PROGRESS
  REFUND_COMPLETED
  CANCELLED_BY_CUSTOMER
}

enum OtpChallengePurpose {
  ACCOUNT_VERIFICATION
  PHONE_VERIFICATION
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  username         String?             @unique @db.VarChar(30)
  passwordHash     String              @map("password_hash")
  emailVerifiedAt  DateTime?           @map("email_verified_at")
  lastLoginAt      DateTime?           @map("last_login_at")
  status           UserStatus          @default(ACTIVE)
  /// Bumped to revoke all access/refresh JWTs (demote, password reset, logout).
  tokenVersion     Int                 @default(0) @map("token_version")
  /// Phase 6 — after a closed home market opens, merchant must re-accept policies for this market.
  pendingMarketReacceptId String?          @map("pending_market_reaccept_id")
  pendingMarketReacceptAt DateTime?        @map("pending_market_reaccept_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  userRoles        UserRole[]
  wallets          Wallet[]
  affiliateProfile AffiliateProfile?
  customerProfile  CustomerProfile?
  pendingMarketReaccept Market?        @relation("UserPendingMarketReaccept", fields: [pendingMarketReacceptId], references: [id], onDelete: SetNull)
  customerOrders   Order[]              @relation("CustomerOrders")
  ownedVendors     Vendor[]            @relation("VendorOwner")
  carts            Cart[]
  orderReturns     OrderReturn[]
  returnHubInspections OrderReturn[] @relation("ReturnHubInspector")
  vendorPayoutInvoicesUploaded VendorPayoutInvoice[] @relation("PayoutInvoiceUploader")
  vendorPayoutInvoicesReviewed VendorPayoutInvoice[] @relation("PayoutInvoiceReviewer")
  shippingAddresses CustomerShippingAddress[]
  orderItemRatings OrderItemRating[]
  productReviews   ProductReview[]     @relation("ProductReviewedBy")
  productEditRequestsReviewed ProductEditRequest[] @relation("ProductEditRequestReviewedBy")
  productMarketOffersReviewed ProductMarketOffer[] @relation("ProductMarketOfferReviewedBy")
  productQuestions ProductQuestion[]   @relation("ProductQuestionAsker")
  vendorMemberships  VendorMember[]      @relation("VendorMemberUser")
  vendorInvitesSent  VendorMember[]      @relation("VendorMemberInvitedBy")
  invoiceDownloads   InvoiceDownloadLog[]
  vendorShippingReviews VendorShippingChangeRequest[] @relation("VendorShippingReviewedBy")
  vendorShippingAudits  VendorShippingAuditLog[]      @relation("VendorShippingAuditActor")
  orderAdminNotesCreated           OrderAdminNote[]              @relation("OrderAdminNoteAuthor")
  orderFulfillmentEscalationsCreated OrderFulfillmentEscalation[] @relation("OrderFulfillmentEscalationAuthor")
  orderCustomerNoticesCreated      OrderCustomerNotice[]         @relation("OrderCustomerNoticeAuthor")
  orderVendorCancellationsCreated  OrderVendorCancellation[]     @relation("OrderVendorCancellationAuthor")
  kycDocumentsOwned                KycDocument[]                 @relation("KycDocumentOwner")
  kycDocumentsReviewed             KycDocument[]                 @relation("KycDocumentReviewedBy")
  kycDocumentsUpdateRequested      KycDocument[]                 @relation("KycDocumentUpdateRequestedBy")
  passwordResetTokens              PasswordResetToken[]
  passwordResetAudits              PasswordResetAuditLog[]
  otpChallenges                    OtpChallenge[]
  wishlistItems                    WishlistItem[]
  consentRecords                   ConsentRecord[]

  @@index([lastLoginAt])
  @@map("users")
}

model Order {
  id                       String          @id @default(cuid())
  marketId                 String          @map("market_id")
  buyerUserId              String          @map("buyer_user_id")
  orderNo                  String          @unique @map("order_no")
  status                   OrderStatus     @default(NEW)
  subtotal                 Decimal         @db.Decimal(18, 2)
  shippingFee              Decimal         @default(0) @db.Decimal(18, 2) @map("shipping_fee")
  discountTotal            Decimal         @default(0) @db.Decimal(18, 2) @map("discount_total")
  vatTotal                 Decimal         @default(0) @db.Decimal(18, 2) @map("vat_total")
  totalAmount              Decimal         @db.Decimal(18, 2) @map("total_amount")
  /// Currency charged to the customer (may be USD on International while ledger stays OMR).
  chargeCurrency           String          @default("SAR") @map("charge_currency") @db.Char(3)
  /// Wallet / commission ledger currency for this order (market default; OMR on International).
  ledgerCurrency           String          @default("SAR") @map("ledger_currency") @db.Char(3)
  /// Locked charge→ledger FX at order time (1 when same currency).
  lockedFxRate             Decimal?        @map("locked_fx_rate") @db.Decimal(18, 8)
  shippingRecipientName    String?         @map("shipping_recipient_name")
  shippingPhone            String?         @map("shipping_phone")
  shippingCountryCode      String?         @map("shipping_country_code")
  shippingCity             String?         @map("shipping_city")
  shippingPostalCode       String?         @map("shipping_postal_code")
  shippingAddressLine1     String?         @map("shipping_address_line_1")
  shippingAddressLine2     String?         @map("shipping_address_line_2")
  paymentMethod            PaymentMethod   @default(COD) @map("payment_method")
  paymentStatus            PaymentStatus   @default(PAID) @map("payment_status")
  checkoutIdempotencyKey   String?         @map("checkout_idempotency_key")
  stripeCheckoutSessionId String?        @unique @map("stripe_checkout_session_id") @db.VarChar(255)
  tapChargeId             String?        @unique @map("tap_charge_id") @db.VarChar(255)
  couponId                 String?         @map("coupon_id")
  couponCodeSnapshot       String?         @map("coupon_code_snapshot") @db.VarChar(32)
  deliveredAt              DateTime?       @map("delivered_at")
  finalInvoiceAllowed      Boolean         @default(false) @map("final_invoice_allowed")
  /// Phase 6 — B2B checkout capture (does not change tax).
  buyingForCompany         Boolean         @default(false) @map("buying_for_company")
  companyName              String?         @map("company_name") @db.VarChar(200)
  companyTaxId             String?         @map("company_tax_id") @db.VarChar(64)
  companyCrNumber          String?         @map("company_cr_number") @db.VarChar(64)
  companyHqAddressLine1    String?         @map("company_hq_address_line_1") @db.VarChar(200)
  companyHqCity            String?         @map("company_hq_city") @db.VarChar(100)
  companyHqCountryCode     String?         @map("company_hq_country_code") @db.Char(2)
  /// Customer accepted FX / transfer / customs risk at checkout (cross-market).
  settlementRiskAcceptedAt DateTime?       @map("settlement_risk_accepted_at")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  buyer                    User            @relation("CustomerOrders", fields: [buyerUserId], references: [id], onDelete: Cascade)
  market                   Market            @relation(fields: [marketId], references: [id], onDelete: Restrict)
  coupon                   Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponApplications       OrderCouponApplication[]
  vendorShippingLines      OrderVendorShipping[]
  vendorInvoicing          OrderVendorInvoicing[]
  items                    OrderItem[]
  returns                  OrderReturn[]
  invoices                 OrderInvoice[]
  adminNotes               OrderAdminNote[]
  fulfillmentEscalations   OrderFulfillmentEscalation[]
  customerNotices          OrderCustomerNotice[]
  vendorCancellations      OrderVendorCancellation[]

  @@unique([buyerUserId, checkoutIdempotencyKey])
  @@index([marketId])
  @@index([buyerUserId, marketId, createdAt])
  @@index([buyerUserId, createdAt])
  @@index([buyerUserId, status])
  @@index([marketId, status])
  @@map("orders")
}

enum ReturnCostZone {
  SAME_CITY
  SAME_COUNTRY
  CROSS_BORDER
  UNKNOWN
}

enum ReturnCostBearer {
  CUSTOMER
  VENDOR
  PLATFORM
}

model OrderReturn {
  id                 String            @id @default(cuid())
  orderId            String            @map("order_id")
  buyerUserId        String            @map("buyer_user_id")
  status             OrderReturnStatus @default(REQUESTED)
  reason             OrderReturnReason
  details            String            @db.Text
  rejectionReason    String?           @map("rejection_reason") @db.Text
  policyAcceptedAt   DateTime          @map("policy_accepted_at")
  /// Return cost snapshot at request (round-trip). Final fields set after hub inspect when needed.
  returnShippingFee  Decimal           @default(0) @map("return_shipping_fee") @db.Decimal(18, 2)
  returnCostZone     ReturnCostZone    @default(UNKNOWN) @map("return_cost_zone")
  returnCostBearer   ReturnCostBearer  @default(CUSTOMER) @map("return_cost_bearer")
  returnCostCurrency String            @default("SAR") @map("return_cost_currency") @db.Char(3)
  returnCostNote     String?           @map("return_cost_note") @db.VarChar(500)
  returnCostFinalFee    Decimal?           @map("return_cost_final_fee") @db.Decimal(18, 2)
  returnCostBearerFinal ReturnCostBearer?  @map("return_cost_bearer_final")
  /// Cross-market: inspect at buyer-market company before accept/reject.
  hubInspectionRequired Boolean              @default(false) @map("hub_inspection_required")
  hubReceivedAt         DateTime?            @map("hub_received_at")
  hubInspectedAt        DateTime?            @map("hub_inspected_at")
  hubInspectedByUserId  String?              @map("hub_inspected_by_user_id")
  hubInspectionNote     String?              @map("hub_inspection_note") @db.VarChar(2000)
  goodsDisposition      ReturnGoodsDisposition @default(HOLD_AT_HUB) @map("goods_disposition")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer              User              @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  hubInspectedBy     User?             @relation("ReturnHubInspector", fields: [hubInspectedByUserId], references: [id], onDelete: SetNull)
  returnUnits        OrderItem[]       @relation("OrderReturnUnits")

  @@index([buyerUserId, createdAt])
  @@index([orderId])
  @@index([status])
  @@map("order_returns")
}

model OrderAdminNote {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  body            String   @db.Text
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("OrderAdminNoteAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_admin_notes")
}

model OrderFulfillmentEscalation {
  id              String                          @id @default(cuid())
  orderId         String                          @map("order_id")
  vendorId        String                          @map("vendor_id")
  fulfillmentType ProductFulfillmentType?         @map("fulfillment_type")
  level           OrderFulfillmentEscalationLevel
  message         String?                         @db.VarChar(2000)
  createdByUserId String                          @map("created_by_user_id")
  createdAt       DateTime                        @default(now()) @map("created_at")
  order           Order                           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor          Vendor                          @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy       User                            @relation("OrderFulfillmentEscalationAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([vendorId, createdAt])
  @@index([orderId, vendorId, fulfillmentType])
  @@map("order_fulfillment_escalations")
}

model OrderCustomerNotice {
  id              String                  @id @default(cuid())
  orderId         String                  @map("order_id")
  type            OrderCustomerNoticeType @default(DELAY)
  body            String                  @db.Text
  createdByUserId String                  @map("created_by_user_id")
  dismissedAt     DateTime?               @map("dismissed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  order           Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("OrderCustomerNoticeAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_customer_notices")
}

model OrderVendorCancellation {
  id                  String                        @id @default(cuid())
  orderId             String                        @map("order_id")
  vendorId            String                        @map("vendor_id")
  reason              String                        @db.Text
  cancelledSubtotal   Decimal                       @map("cancelled_subtotal") @db.Decimal(18, 2)
  cancelledShipping   Decimal                       @map("cancelled_shipping") @db.Decimal(18, 2)
  cancelledDiscount   Decimal                       @map("cancelled_discount") @db.Decimal(18, 2)
  cancelledVat        Decimal                       @map("cancelled_vat") @db.Decimal(18, 2)
  refundAmount        Decimal                       @map("refund_amount") @db.Decimal(18, 2)
  status              OrderVendorCancellationStatus @default(COMPLETED)
  failureReason       String?                       @map("failure_reason") @db.Text
  createdByUserId     String                        @map("created_by_user_id")
  createdAt           DateTime                      @default(now()) @map("created_at")
  order               Order                         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor              Vendor                        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  createdBy           User                          @relation("OrderVendorCancellationAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([orderId, vendorId])
  @@index([orderId])
  @@index([vendorId])
  @@map("order_vendor_cancellations")
}

model OrderInvoice {
  id           String              @id @default(cuid())
  orderId      String              @map("order_id")
  vendorId     String              @map("vendor_id")
  documentType InvoiceDocumentType @map("document_type")
  invoiceNo    String              @unique @map("invoice_no") @db.VarChar(64)
  storageKey   String              @map("storage_key") @db.VarChar(500)
  fileUrl      String?             @map("file_url") @db.VarChar(500)
  subtotal     Decimal             @db.Decimal(18, 2)
  vatTotal     Decimal             @map("vat_total") @db.Decimal(18, 2)
  totalAmount  Decimal             @map("total_amount") @db.Decimal(18, 2)
  currency     String              @default("SAR") @db.Char(3)
  generatedAt  DateTime            @default(now()) @map("generated_at")
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor       Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  downloads    InvoiceDownloadLog[]

  @@unique([orderId, vendorId, documentType])
  @@index([orderId])
  @@index([vendorId])
  @@map("order_invoices")
}

model InvoiceDownloadLog {
  id           String       @id @default(cuid())
  invoiceId    String       @map("invoice_id")
  userId       String       @map("user_id")
  downloadedAt DateTime     @default(now()) @map("downloaded_at")
  invoice      OrderInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([userId, downloadedAt])
  @@map("invoice_download_logs")
}

model Vendor {
  id             String             @id @default(cuid())
  marketId       String             @map("market_id")
  ownerUserId    String             @map("owner_user_id")
  storeName      String             @map("store_name")
  slug           String             @db.VarChar(64)
  countryCode    String             @default("SA") @map("country_code") @db.Char(2)
  primaryMarketId String            @map("primary_market_id")
  addressLine1   String             @map("address_line_1") @db.VarChar(200)
  addressLine2   String?            @map("address_line_2") @db.VarChar(200)
  state          String?            @db.VarChar(120)
  city           String             @db.VarChar(120)
  postalCode     String             @map("postal_code") @db.VarChar(20)
  about          String?            @db.Text
  logoUrl               String?            @map("logo_url") @db.VarChar(500)
  bannerUrl             String?            @map("banner_url") @db.VarChar(500)
  shippingNotes            String?                     @map("shipping_notes") @db.VarChar(2000)
  defaultShippingFee       Decimal?                    @map("default_shipping_fee") @db.Decimal(18, 2)
  shippingSetupAt          DateTime?                   @map("shipping_setup_at")
  shippingMode             VendorShippingMode          @default(DIRECT) @map("shipping_mode")
  indirectFulfillment      VendorIndirectFulfillment?  @map("indirect_fulfillment")
  shippingFee              Decimal?                    @map("shipping_fee") @db.Decimal(18, 2)
  shippingProfileStatus    VendorShippingProfileStatus @default(PENDING_APPROVAL) @map("shipping_profile_status")
  shippingApprovedAt       DateTime?                   @map("shipping_approved_at")
  shippingFeeSetByAdmin    Boolean                     @default(false) @map("shipping_fee_set_by_admin")
  storeApprovalStatus      VendorStoreApprovalStatus   @default(PENDING) @map("store_approval_status")
  storeApprovedAt          DateTime?                   @map("store_approved_at")
  storeApprovedByUserId    String?                     @map("store_approved_by_user_id")
  storeApprovalNote        String?                     @map("store_approval_note") @db.VarChar(500)
  /// Phase 2 wizard lifecycle (under registration → under review → active).
  onboardingStatus         VendorOnboardingStatus      @default(UNDER_REGISTRATION) @map("onboarding_status")
  onboardingStep           Int                         @default(1) @map("onboarding_step")
  onboardingSubmittedAt    DateTime?                   @map("onboarding_submitted_at")
  repNameEn                String?                     @map("rep_name_en") @db.VarChar(120)
  repNameOther             String?                     @map("rep_name_other") @db.VarChar(120)
  legalNameEn              String?                     @map("legal_name_en") @db.VarChar(200)
  legalNameOther           String?                     @map("legal_name_other") @db.VarChar(200)
  storeNameOther           String?                     @map("store_name_other") @db.VarChar(120)
  storeDescriptionEn       String?                     @map("store_description_en") @db.Text
  storeDescriptionOther    String?                     @map("store_description_other") @db.Text
  entityType               VendorEntityType?           @map("entity_type")
  shortBusinessNote        String?                     @map("short_business_note") @db.VarChar(500)
  commissionTermsAcceptedAt DateTime?                  @map("commission_terms_accepted_at")
  crossMarketTermsAcceptedAt DateTime?                 @map("cross_market_terms_accepted_at")
  /// Vendor accepts FX / transfer-fee / customs risk when listing cross-market.
  settlementRiskConsentAt    DateTime?                 @map("settlement_risk_consent_at")
  payoutAccountHolder   String?            @map("payout_account_holder") @db.VarChar(200)
  payoutIban            String?            @map("payout_iban") @db.VarChar(34)
  contactPhone          String?            @map("contact_phone") @db.VarChar(32)
  payoutSetupAt         DateTime?          @map("payout_setup_at")
  planCode              String             @default("FREE") @map("plan_code") @db.VarChar(32)
  metaTitle             String?            @map("meta_title") @db.VarChar(70)
  metaDescription       String?            @map("meta_description") @db.VarChar(160)
  invoiceLegalName      String?            @map("invoice_legal_name") @db.VarChar(200)
  invoiceVatTrn         String?            @map("invoice_vat_trn") @db.VarChar(32)
  invoiceVatPercent     Decimal?           @map("invoice_vat_percent") @db.Decimal(5, 2)
  invoiceAddressLine1   String?            @map("invoice_address_line_1") @db.VarChar(200)
  invoiceAddressLine2   String?            @map("invoice_address_line_2") @db.VarChar(200)
  invoiceCity           String?            @map("invoice_city") @db.VarChar(120)
  invoicePostalCode     String?            @map("invoice_postal_code") @db.VarChar(20)
  invoiceCountryCode    String?            @map("invoice_country_code") @db.Char(2)
  invoiceLogoUrl        String?            @map("invoice_logo_url") @db.VarChar(500)
  internationalSalesConsentAt      DateTime? @map("international_sales_consent_at")
  internationalSalesConsentVersion String?   @map("international_sales_consent_version") @db.VarChar(32)
  hasPhysicalShop                  Boolean   @default(false) @map("has_physical_shop")
  hasCommercialLicense             Boolean   @default(false) @map("has_commercial_license")
  licenseTypeCode                  String?   @map("license_type_code") @db.VarChar(64)
  licenseTypeOther                 String?   @map("license_type_other") @db.VarChar(120)
  ecommerceOnLicense               Boolean   @default(false) @map("ecommerce_on_license")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  owner          User               @relation("VendorOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  market         Market             @relation(fields: [marketId], references: [id], onDelete: Restrict)
  primaryMarket  Market             @relation("VendorPrimaryMarket", fields: [primaryMarketId], references: [id], onDelete: Restrict)
  products       Product[]
  orderItems     OrderItem[]
  permissions    VendorPermission[]
  coupons        Coupon[]
  couponApplications      OrderCouponApplication[]
  shippingChangeRequests  VendorShippingChangeRequest[]
  shippingAuditLogs       VendorShippingAuditLog[]
  productEditRequests     ProductEditRequest[]
  orderVendorShipping     OrderVendorShipping[]
  orderVendorInvoicing    OrderVendorInvoicing[]
  members                 VendorMember[]
  bills                   VendorBill[]
  orderInvoices           OrderInvoice[]
  fulfillmentEscalations  OrderFulfillmentEscalation[]
  vendorCancellations     OrderVendorCancellation[]
  kycDocuments            KycDocument[]
  deliveryCities          VendorDeliveryCity[]
  onboardingFieldReviews  VendorOnboardingFieldReview[]
  profileChangeRequests   VendorProfileChangeRequest[]
  payoutInvoices          VendorPayoutInvoice[]

  @@unique([marketId, slug])
  @@unique([ownerUserId, marketId])
  @@index([ownerUserId])
  @@index([primaryMarketId])
  @@index([shippingProfileStatus])
  @@index([storeApprovalStatus])
  @@index([onboardingStatus])
  @@map("vendors")
}

/// Vendor uploads purchase invoice after bank payout received (cross-market books).
model VendorPayoutInvoice {
  id                       String                    @id @default(cuid())
  marketId                 String                    @map("market_id")
  vendorId                 String                    @map("vendor_id")
  uploadedByUserId         String                    @map("uploaded_by_user_id")
  withdrawalTransactionId  String                    @unique @map("withdrawal_transaction_id")
  amountReceived           Decimal                   @map("amount_received") @db.Decimal(18, 2)
  currency                 String                    @db.Char(3)
  orderNosText             String                    @map("order_nos_text") @db.VarChar(2000)
  fileStorageKey           String                    @map("file_storage_key") @db.VarChar(500)
  fileOriginalName         String?                   @map("file_original_name") @db.VarChar(255)
  status                   VendorPayoutInvoiceStatus @default(PENDING_REVIEW)
  reviewNote               String?                   @map("review_note") @db.VarChar(2000)
  reviewedByUserId         String?                   @map("reviewed_by_user_id")
  reviewedAt               DateTime?                 @map("reviewed_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  market                   Market                    @relation(fields: [marketId], references: [id], onDelete: Restrict)
  vendor                   Vendor                    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  uploadedBy               User                      @relation("PayoutInvoiceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy               User?                     @relation("PayoutInvoiceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  withdrawalTransaction    WalletTransaction         @relation(fields: [withdrawalTransactionId], references: [id], onDelete: Restrict)

  @@index([marketId, status, createdAt])
  @@index([vendorId, createdAt])
  @@map("vendor_payout_invoices")
}

/// Admin page-by-page field decisions during vendor onboarding review (Phase 2).
model VendorOnboardingFieldReview {
  id           String                        @id @default(cuid())
  vendorId     String                        @map("vendor_id")
  pageKey      String                        @map("page_key") @db.VarChar(32)
  fieldKey     String                        @map("field_key") @db.VarChar(64)
  decision     VendorOnboardingFieldDecision @default(PENDING)
  note         String?                       @db.VarChar(1000)
  decidedByUserId String?                    @map("decided_by_user_id")
  decidedAt    DateTime?                     @map("decided_at")
  createdAt    DateTime                      @default(now()) @map("created_at")
  updatedAt    DateTime                      @updatedAt @map("updated_at")
  vendor       Vendor                        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, pageKey, fieldKey])
  @@index([vendorId, pageKey])
  @@map("vendor_onboarding_field_reviews")
}

/// Vendor-requested profile changes after ACTIVE (Phase 2) — sets onboarding back to UNDER_REVIEW.
model VendorProfileChangeRequest {
  id              String   @id @default(cuid())
  vendorId        String   @map("vendor_id")
  status          String   @default("PENDING") @db.VarChar(32)
  proposedJson    Json     @map("proposed_json")
  vendorNote      String?  @map("vendor_note") @db.VarChar(2000)
  adminNote       String?  @map("admin_note") @db.VarChar(2000)
  reviewedByUserId String? @map("reviewed_by_user_id")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  vendor          Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, status, createdAt])
  @@map("vendor_profile_change_requests")
}

model KycDocument {
  id                String            @id @default(cuid())
  subjectType       KycSubjectType    @map("subject_type")
  subjectKey        String            @map("subject_key") @db.VarChar(100)
  userId            String?           @map("user_id")
  vendorId          String?           @map("vendor_id")
  documentType      KycDocumentType   @map("document_type")
  status            KycDocumentStatus @default(UPLOADED)
  storageKey        String            @map("storage_key") @db.VarChar(500)
  originalFileName  String            @map("original_file_name") @db.VarChar(255)
  mimeType          String            @map("mime_type") @db.VarChar(100)
  fileSizeBytes     Int               @map("file_size_bytes")
  description       String?           @db.Text
  documentExpiresAt DateTime?         @map("document_expires_at")
  ibanNumber        String?           @map("iban_number") @db.VarChar(34)
  identityDocumentKind      AffiliateIdentityDocumentKind? @map("identity_document_kind")
  identityDocumentKindOther String?                        @map("identity_document_kind_other") @db.VarChar(120)
  documentNumber            String?                        @map("document_number") @db.VarChar(64)
  rejectionReason   String?           @map("rejection_reason") @db.Text
  reviewedByUserId  String?           @map("reviewed_by_user_id")
  reviewedAt        DateTime?         @map("reviewed_at")
  submittedAt               DateTime?         @map("submitted_at")
  updateRequestedAt         DateTime?         @map("update_requested_at")
