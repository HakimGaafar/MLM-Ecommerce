# Safe template only. Copy to `.env` and provide real values locally.
# Never commit `.env` or any production credentials.

# Required
NEXT_PUBLIC_APP_NAME=Vandsoq
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_URL=mailto:support@yourdomain.com
JWT_SECRET=replace-with-a-long-random-secret-min-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret-min-32-chars
# Optional JWT claim binding (defaults: vandsoq / vandsoq-web)
# JWT_ISSUER=vandsoq
# JWT_AUDIENCE=vandsoq-web
# Access token TTL minutes (prod hard-capped at 60)
# SESSION_ACCESS_MINUTES=15
AUTH_COOKIE_NAME=mlm_session
AUTH_REFRESH_COOKIE_NAME=mlm_refresh
# Host / local app: use localhost. Docker Compose overrides these to postgres/redis.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mlm_ecommerce?schema=public
REDIS_URL=redis://localhost:6379
PHASE_XII_ENABLED=false

# Optional worker settings (used when PHASE_XII_ENABLED=true)
# WALLET_REWARDS_DISPATCH=queue
# WALLET_SETTLEMENT_DISPATCH=queue
# WORKER_CONCURRENCY=5

# Database deploy (staging/production): applies migrations + mandatory reference data (roles, markets, etc.)
# npm run db:deploy
# Demo catalog/users only (optional): ALLOW_PRODUCTION_SEED=true npm run db:seed

# Card payments — active PSP (default: tap). Stripe stays in repo but inactive unless selected.
# PAYMENT_GATEWAY=tap
# TAP_SECRET_KEY=sk_test_...
# TAP_PUBLIC_KEY=pk_test_...   # unused for redirect Charges; reserved
# NEXT_PUBLIC_TAP_PUBLIC_KEY=pk_test_...
# TAP_MERCHANT_ID=   # optional; required by some Tap accounts
# TAP_SOURCE_ID=src_all
# TAP_API_BASE=https://api.tap.company/v2
# TAP_REFUND_POST_URL=   # optional async refund notify URL (Tap refunds post.url)
# Webhook: post.url → {APP_BASE_URL}/api/v1/webhooks/tap (set automatically on charge create; hashstring required)
#
# Stripe (kept in repo; set PAYMENT_GATEWAY=stripe to re-enable)
# PAYMENT_GATEWAY=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# Cross-market settlement payout snapshot (fraction 0–1; statement line only)
# SETTLEMENT_TRANSFER_FEE_RATE=0
# Reserved future values: hyperpay, myfatoorah

# Product image storage (local or S3-compatible)
STORAGE_PROVIDER=local
# S3_BUCKET=your-bucket-name
# S3_REGION=auto
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# CDN_BASE_URL=https://cdn.example.com
# S3_KEY_PREFIX=products
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
# S3_FORCE_PATH_STYLE=true

# Private KYC document storage
# KYC_STORAGE_PROVIDER=local
# KYC_LOCAL_DIR=storage/kyc-documents
# Private payout purchase invoices (not under public/)
# PAYOUT_INVOICE_LOCAL_DIR=storage/payout-invoices
# KYC_S3_BUCKET=your-private-kyc-bucket
# KYC_S3_REGION=auto
# KYC_S3_KEY_PREFIX=kyc-documents
# KYC_S3_ENDPOINT=https://your-s3-compatible-endpoint
# KYC_S3_FORCE_PATH_STYLE=true
# KYC_AWS_ACCESS_KEY_ID=replace-me
# KYC_AWS_SECRET_ACCESS_KEY=replace-me

# Optional market routing
# MARKET_COOKIE_NAME=mlm_active_market
# APP_ROOT_DOMAIN=example.com
# DEFAULT_DEV_MARKET=SA
# GEO_IP_HEADER=CF-IPCountry
# DEV_GEO_COUNTRY=SA

# Optional operational settings
# RATE_LIMIT_FAIL_CLOSED=true
# FULFILLMENT_SLA_NEW_HOURS=48
# FULFILLMENT_SLA_PROCESSING_HOURS=72
# MIN_WITHDRAWAL_AMOUNT_SAR=250
# VANDSOQ_LEGAL_NAME=Vandsoq Marketplace
# VANDSOQ_VAT_TRN=
# VANDSOQ_ADDRESS_LINE1=
# VANDSOQ_ADDRESS_LINE2=
# VANDSOQ_CITY=
# VANDSOQ_POSTAL_CODE=
# VANDSOQ_COUNTRY_CODE=SA
# VANDSOQ_LOGO_URL=
# INVOICE_ALLOW_BEFORE_RETURN_WINDOW=true
# FULFILLMENT_SLA_BYPASS=false
# FULFILLMENT_SLA_DEMO_STUCK=false

# Optional transactional email (password reset / OTP / welcome). Without RESEND_API_KEY, messages are logged to the server console in development.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Vandsoq <noreply@yourdomain.com>
# For production OTP delivery, verify your sending domain in Resend (onboarding@resend.dev only works for the account owner).

# Optional phone SMS OTP (off by default — enable only for provider testing)
# PHONE_OTP_ENABLED=false

# Cloudflare Turnstile (Phase 2 seller onboarding). Skip verify in non-production when secret unset.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Optional branding links
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/yourpage
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/yourpage
# NEXT_PUBLIC_SOCIAL_X=https://x.com/yourpage
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/yourpage

# Optional per-market contact (used on /contact and footer). WhatsApp: digits with country code.
# NEXT_PUBLIC_WHATSAPP_SA=9665XXXXXXXX
# NEXT_PUBLIC_WHATSAPP_SA_DISPLAY=+966 5X XXX XXXX
# NEXT_PUBLIC_MAPS_SA=https://maps.app.goo.gl/your-saudi-office
# NEXT_PUBLIC_WHATSAPP_EG=20XXXXXXXXXX
# NEXT_PUBLIC_WHATSAPP_EG_DISPLAY=+20 1X XXX XXXX
# NEXT_PUBLIC_MAPS_EG=https://maps.app.goo.gl/your-egypt-office
# NEXT_PUBLIC_WHATSAPP_OM=96877523743
# NEXT_PUBLIC_WHATSAPP_OM_DISPLAY=+968 7752 3743
# NEXT_PUBLIC_MAPS_OM=https://maps.app.goo.gl/qYSFDbMNaF9YXAT9A
# NEXT_PUBLIC_WHATSAPP_GLOBAL=96877523743
# NEXT_PUBLIC_WHATSAPP_GLOBAL_DISPLAY=+968 7752 3743
# NEXT_PUBLIC_MAPS_GLOBAL=https://maps.app.goo.gl/qYSFDbMNaF9YXAT9A
